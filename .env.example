
# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider: openai, anthropic, groq, gemini, openrouter, ollama
LLM_PROVIDER=groq
LLM_MODEL=groq/llama-3.3-70b-versatile

# Provider API keys (fill in only the provider you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama endpoint (no API key normally required)
OLLAMA_BASE_URL=http://localhost:11434

# Vector Database
VECTOR_DB_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Financial Data
SEC_USER_AGENT=
FINANCIAL_API_KEY=

# Web Search
WEB_SEARCH_API_KEY=

# Agent Configuration
MAX_TOOL_CALLS=20
TOOL_TIMEOUT_SECONDS=30
MAX_RETRIES=3
